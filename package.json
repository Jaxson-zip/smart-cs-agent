{
  "name": "smart-cs-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @smart-cs-agent/web",
    "dev:web": "npm run dev --workspace @smart-cs-agent/web",
    "dev:api": "npm run start:dev --workspace @smart-cs-agent/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:smoke": "node scripts/demo/wecom-sandbox-smoke.mjs",
    "demo:real-channel-smoke": "node scripts/demo/real-channel-webhook-smoke.mjs",
    "verify:channel-runbook": "node scripts/verify-channel-queue-runbook.mjs",
    "verify:operator-bootstrap": "node scripts/verify-operator-bootstrap.mjs",
    "verify:production-alerting": "node scripts/verify-production-alerting.mjs",
    "verify:production-canary": "node scripts/verify-production-canary.mjs",
    "verify:production-launch": "node scripts/verify-production-launch.mjs",
    "verify:provider-adapters": "node scripts/verify-provider-adapters.mjs",
    "verify:provider-readonly": "node scripts/verify-provider-readonly.mjs",
    "verify:provider-read-contract": "node scripts/verify-provider-read-contract.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "operator:bootstrap-admin": "node scripts/bootstrap-operator-admin.mjs"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
