{
  "name": "smart-cs-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @smart-cs-agent/web",
    "dev:web": "npm run dev --workspace @smart-cs-agent/web",
    "dev:api": "npm run start:dev --workspace @smart-cs-agent/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:smoke": "node scripts/demo/wecom-sandbox-smoke.mjs",
    "demo:real-channel-smoke": "node scripts/demo/real-channel-webhook-smoke.mjs",
    "verify:channel-runbook": "node scripts/verify-channel-queue-runbook.mjs",
    "verify:operator-bootstrap": "node scripts/verify-operator-bootstrap.mjs",
    "verify:production-alerting": "node scripts/verify-production-alerting.mjs",
    "verify:production-canary": "node scripts/verify-production-canary.mjs",
    "verify:production-deploy-artifacts": "node scripts/verify-production-deploy-artifacts.mjs",
    "verify:production-image-builds": "node scripts/verify-production-image-builds.mjs",
    "verify:production-image-builds:docker": "node scripts/verify-production-image-builds.mjs --docker",
    "verify:production-container-smoke": "node scripts/verify-production-container-smoke.mjs",
    "verify:production-container-smoke:docker": "node scripts/verify-production-container-smoke.mjs --docker",
    "verify:production-image-security": "node scripts/verify-production-image-security.mjs",
    "verify:production-image-security:docker": "node scripts/verify-production-image-security.mjs --docker",
    "verify:production-release-provenance": "node scripts/verify-production-release-provenance.mjs",
    "verify:production-release-provenance:safe": "node scripts/verify-production-release-provenance.mjs --from-env",
    "verify:production-release-evidence": "node scripts/verify-production-release-evidence.mjs",
    "verify:production-release-evidence:safe": "node scripts/verify-production-release-evidence.mjs --from-env",
    "verify:production-change-approval": "node scripts/verify-production-change-approval.mjs",
    "verify:production-change-approval:safe": "node scripts/verify-production-change-approval.mjs --from-env",
    "verify:production-launch-binding": "node scripts/verify-production-launch-binding.mjs",
    "verify:production-launch-binding:safe": "node scripts/verify-production-launch-binding.mjs --from-env",
    "verify:production-launch": "node scripts/verify-production-launch.mjs",
    "verify:provider-adapters": "node scripts/verify-provider-adapters.mjs",
    "verify:provider-readonly": "node scripts/verify-provider-readonly.mjs",
    "verify:provider-read-contract": "node scripts/verify-provider-read-contract.mjs",
    "verify:provider-read-audit": "node scripts/verify-provider-read-audit.mjs",
    "verify:provider-read-operations": "node scripts/verify-provider-read-operations.mjs",
    "verify:provider-credential-boundary": "node scripts/verify-provider-credential-boundary.mjs",
    "verify:provider-credential-store": "node scripts/verify-provider-credential-store.mjs",
    "verify:provider-read-harness": "node scripts/verify-provider-read-harness.mjs",
    "verify:merchant-launch-preflight": "node scripts/verify-merchant-launch-preflight.mjs",
    "verify:merchant-launch-preflight:safe": "node scripts/verify-merchant-launch-preflight.mjs --from-env",
    "generate:launch-evidence": "node scripts/generate-launch-evidence.mjs",
    "generate:launch-evidence:safe": "node scripts/generate-launch-evidence.mjs --from-env",
    "verify:launch-evidence-archive": "node scripts/verify-launch-evidence-archive.mjs",
    "verify:launch-evidence-archive:safe": "node scripts/verify-launch-evidence-archive.mjs --from-env",
    "verify:launch-manifest": "node scripts/verify-launch-manifest.mjs",
    "verify:launch-manifest:safe": "node scripts/verify-launch-manifest.mjs --from-env",
    "verify:launch-evidence": "node scripts/verify-launch-evidence.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "operator:bootstrap-admin": "node scripts/bootstrap-operator-admin.mjs"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
