generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AfterSalesCase {
  id              String   @id @default(cuid()) // Corresponds to caseId
  merchantId      String
  channel         String
  customerName    String
  orderId         String?
  category        String
  riskLevel       String
  automationMode  String
  customerMessage String
  customerReply   String?
  actions         Json?    // Stores the array of actions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
