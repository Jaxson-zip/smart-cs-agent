generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  level     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  tenantId        String
  shopId          String
  customerId      String?
  platform        String
  status          String
  totalAmount     Float
  shippingAddress String?
  items           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id         String   @id @default(cuid())
  tenantId   String
  platform   String
  externalId String
  messages   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AfterSalesCase {
  id              String   @id @default(cuid()) // Corresponds to caseId
  merchantId      String
  channel         String
  customerName    String
  orderId         String?
  category        String
  riskLevel       String
  automationMode  String
  customerMessage String
  customerReply   String?
  actions         Json? // Stores the array of actions (legacy, keeping for compatibility if needed)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages    CaseMessage[]
  caseActions CaseAction[]
  auditLogs   AuditLog[]
}

model NormalizedChannelEvent {
  id                     String   @id @default(cuid())
  source                 String
  merchantId             String
  channel                String
  externalConversationId String
  externalMessageId      String
  senderName             String
  text                   String
  receivedAt             DateTime
  createdAt              DateTime @default(now())
}

model CaseMessage {
  id         String         @id @default(cuid())
  caseId     String
  case       AfterSalesCase @relation(fields: [caseId], references: [id])
  senderType String // "customer" | "agent" | "operator"
  text       String
  createdAt  DateTime       @default(now())
}

model CaseAction {
  id        String         @id @default(cuid())
  caseId    String
  case      AfterSalesCase @relation(fields: [caseId], references: [id])
  type      String
  status    String
  params    Json?
  result    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AuditLog {
  id        String          @id @default(cuid())
  caseId    String?
  case      AfterSalesCase? @relation(fields: [caseId], references: [id])
  action    String
  details   Json?
  createdAt DateTime        @default(now())
}

model OperatorAccount {
  id             String   @id @default(cuid())
  username       String   @unique
  tenantId       String
  operatorId     String
  role           String
  passwordHash   String
  apiKey         String
  disabled       Boolean  @default(false)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, operatorId])
  @@index([tenantId, role])
}

model RuleConfig {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}
