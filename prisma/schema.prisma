generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  level     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  tenantId        String
  shopId          String
  customerId      String?
  platform        String
  status          String
  totalAmount     Float
  shippingAddress String?
  items           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id         String   @id @default(cuid())
  tenantId   String
  platform   String
  externalId String
  messages   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AfterSalesCase {
  id              String   @id @default(cuid()) // Corresponds to caseId
  merchantId      String
  channel         String
  customerName    String
  orderId         String?
  category        String
  riskLevel       String
  automationMode  String
  customerMessage String
  customerReply   String?
  actions         Json? // Stores the array of actions (legacy, keeping for compatibility if needed)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages    CaseMessage[]
  caseActions CaseAction[]
  auditLogs   AuditLog[]
}

enum ChannelEventReviewStatus {
  pending
  processing
  replayed
  ignored
}

model NormalizedChannelEvent {
  id                     String                   @id @default(cuid())
  source                 String
  merchantId             String
  channel                String
  externalConversationId String
  externalMessageId      String
  senderName             String
  text                   String
  receivedAt             DateTime
  reviewStatus           ChannelEventReviewStatus @default(pending)
  reviewedBy             String?
  reviewedAt             DateTime?
  replayedCaseId         String?
  reviewNote             String?
  createdAt              DateTime                 @default(now())

  @@index([merchantId, source, reviewStatus, createdAt])
}

model ChannelWebhookReceipt {
  id         String   @id @default(cuid())
  channel    String
  tenantId   String
  eventId    String
  bodySha256 String
  eventTime  DateTime
  receivedAt DateTime @default(now())

  @@unique([channel, tenantId, eventId])
  @@index([receivedAt])
}

model ProviderReadRun {
  id                   String   @id @default(cuid())
  tenantId             String
  operatorId           String?
  caseId               String
  channel              String
  readCapability       String
  idempotencyKey       String
  lookupHash           String
  lookupKeys           Json
  requestHash          String
  status               String
  networkExecution     String
  providerDataReturned Boolean  @default(false)
  operatorVisibleResult String
  policyReason         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, channel, createdAt])
  @@index([tenantId, caseId, createdAt])
}

model ProviderWriteRequest {
  id                         String   @id @default(cuid())
  tenantId                   String
  operatorId                 String?
  caseId                     String
  channel                    String
  action                     String
  idempotencyKeyHash         String
  payloadHash                String
  payloadKeys                Json
  requestHash                String
  status                     String
  networkExecution           String
  providerMutationExecuted   Boolean  @default(false)
  customerVisibleMessageSent Boolean  @default(false)
  operatorVisibleResult      String
  policyReason               String?
  reviewerOperatorId         String?
  reviewedAt                 DateTime?
  reviewReasonCode           String?
  reviewFingerprint          String?
  payloadEscrowStatus        String   @default("not_stored")
  payloadEscrowFingerprint   String?
  payloadEscrowEnvelopeFingerprint String?
  payloadEscrowMode          String   @default("disabled")
  payloadEscrowCreatedAt     DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, idempotencyKeyHash])
  @@index([tenantId, channel, createdAt])
  @@index([tenantId, caseId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, reviewedAt])
  @@index([tenantId, reviewerOperatorId, reviewedAt])
}

model ProviderWriteExecutionAttempt {
  id                         String   @id @default(cuid())
  tenantId                   String
  providerWriteRequestId     String
  operatorId                 String?
  channel                    String
  action                     String
  status                     String
  idempotencyKeyHash         String
  requestHash                String
  attemptFingerprint         String
  payloadEscrowStatus        String   @default("not_stored")
  payloadEscrowOpened        Boolean  @default(false)
  networkExecution           String
  providerMutationExecuted   Boolean  @default(false)
  customerVisibleMessageSent Boolean  @default(false)
  operatorVisibleResult      String
  policyReason               String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, providerWriteRequestId, idempotencyKeyHash])
  @@index([tenantId, providerWriteRequestId, createdAt])
  @@index([tenantId, status, createdAt])
}

model CaseMessage {
  id         String         @id @default(cuid())
  caseId     String
  case       AfterSalesCase @relation(fields: [caseId], references: [id])
  senderType String // "customer" | "agent" | "operator"
  text       String
  createdAt  DateTime       @default(now())
}

model CaseAction {
  id        String         @id @default(cuid())
  caseId    String
  case      AfterSalesCase @relation(fields: [caseId], references: [id])
  type      String
  status    String
  params    Json?
  result    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AuditLog {
  id        String          @id @default(cuid())
  caseId    String?
  case      AfterSalesCase? @relation(fields: [caseId], references: [id])
  action    String
  details   Json?
  createdAt DateTime        @default(now())
}

model OperatorAccount {
  id             String   @id @default(cuid())
  username       String   @unique
  tenantId       String
  operatorId     String
  role           String
  passwordHash   String
  apiKey         String
  disabled       Boolean  @default(false)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, operatorId])
  @@index([tenantId, role])
}

model RuleConfig {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}
