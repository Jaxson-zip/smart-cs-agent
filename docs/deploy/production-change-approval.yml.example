name: smart-cs-agent production change approval

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  change-approval:
    name: Verify production change approval package
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Verify production release evidence boundary
        env:
          SMARTCS_PRODUCTION_RELEASE_EVIDENCE_FILE: production-release-evidence-artifacts/production-release-evidence.json
          SMARTCS_PRODUCTION_RELEASE_EVIDENCE_REQUIRE_PASS: "true"
        run: npm run verify:production-release-evidence:safe

      - name: Verify change approval static boundary
        run: npm run verify:production-change-approval

      - name: Import sanitized production change approval
        env:
          SMARTCS_PRODUCTION_CHANGE_APPROVAL_FILE: production-change-approval-artifacts/production-change-approval.json
        run: test -f "$SMARTCS_PRODUCTION_CHANGE_APPROVAL_FILE"

      - name: Verify sanitized production change approval
        env:
          SMARTCS_PRODUCTION_CHANGE_APPROVAL_FILE: production-change-approval-artifacts/production-change-approval.json
          SMARTCS_PRODUCTION_CHANGE_APPROVAL_REQUIRE_PASS: "true"
        run: npm run verify:production-change-approval:safe

      - name: Upload production change approval
        uses: actions/upload-artifact@v4
        with:
          name: production-change-approval-artifacts
          path: production-change-approval-artifacts/production-change-approval.json
          if-no-files-found: error
