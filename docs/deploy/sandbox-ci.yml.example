name: Sandbox CI

on:
  push:
  pull_request:

env:
  DATABASE_URL: postgresql://smartcs_ci:smartcs_ci@localhost:5432/smartcs_ci?schema=public
  OPENAI_API_KEY: ""
  WEB_ORIGIN: http://localhost:3000
  PORT: "4100"
  WECOM_SANDBOX_ENABLED: "true"
  REAL_CHANNEL_WEBHOOKS_ENABLED: "false"
  REAL_CHANNEL_WEBHOOK_SECRETS: "[]"
  REAL_CHANNEL_WEBHOOK_ALLOWLIST: "[]"
  REAL_CHANNEL_WEBHOOK_MAX_AGE_SECONDS: "300"
  REAL_CHANNEL_WEBHOOK_RATE_LIMIT_PER_MINUTE: "0"
  CHANNEL_QUEUE_PENDING_WARN_THRESHOLD: ""
  CHANNEL_QUEUE_OLDEST_PENDING_WARN_SECONDS: ""
  CHANNEL_QUEUE_STALE_PROCESSING_WARN_THRESHOLD: ""
  CHANNEL_QUEUE_STALE_AFTER_MINUTES: "15"
  API_URL: http://localhost:4100
  OPERATOR_API_KEY: dev_operator_key
  OPERATOR_SESSION_SECRET: ci_operator_session_secret
  OPERATOR_IDENTITY_PROVIDER: database
  OPERATOR_ACCOUNT_SOURCE: database
  OPERATOR_SESSION_ACCOUNTS: '[{"username":"demo","password":"demo123456","tenantId":"demo_tenant","operatorId":"sandbox_operator","role":"admin","apiKey":"dev_operator_key","sessionVersion":1}]'
  NEXT_PUBLIC_API_URL: http://localhost:4100
  NEXT_PUBLIC_WS_URL: http://localhost:4100
  NEXT_PUBLIC_ENABLE_OFFLINE_DEMO: "false"

jobs:
  quality:
    name: Install, test, typecheck, lint, build
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma client
        run: npm run db:generate

      - name: Run API tests
        run: npm run test --workspace @smart-cs-agent/api

      - name: Run Web tests
        run: npm run test --workspace @smart-cs-agent/web

      - name: Typecheck workspaces
        run: npm run typecheck --workspaces --if-present -- --pretty false

      - name: Lint workspaces
        run: npm run lint --workspaces --if-present -- --max-warnings=0

      - name: Build workspaces
        run: npm run build --workspaces --if-present

      - name: Verify operator bootstrap script
        run: npm run verify:operator-bootstrap
