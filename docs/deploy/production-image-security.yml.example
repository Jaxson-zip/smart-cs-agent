name: smart-cs-agent production image security

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  image-security:
    name: Build, smoke, and scan production images
    runs-on: ubuntu-latest
    timeout-minutes: 50

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Verify deployment artifact metadata
        run: npm run verify:production-deploy-artifacts

      - name: Build production images without publishing
        run: npm run verify:production-image-builds:docker

      - name: Smoke production containers without publishing
        run: npm run verify:production-container-smoke:docker

      - name: Generate SBOM and vulnerability evidence
        run: npm run verify:production-image-security:docker -- --artifacts-dir=production-image-security-artifacts

      - name: Upload image security evidence
        uses: actions/upload-artifact@v4
        with:
          name: production-image-security-artifacts
          path: production-image-security-artifacts
          if-no-files-found: error
