services:
  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?set POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:?set POSTGRES_DB}
    volumes:
      - smart-cs-agent-postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 30s
      timeout: 5s
      retries: 5

  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      NODE_ENV: production
      PORT: 4100
      DATABASE_URL: ${DATABASE_URL:?set DATABASE_URL}
      WEB_ORIGIN: ${WEB_ORIGIN:?set WEB_ORIGIN}
      WECOM_SANDBOX_ENABLED: "false"
      REAL_CHANNEL_WEBHOOKS_ENABLED: ${REAL_CHANNEL_WEBHOOKS_ENABLED:-false}
      REAL_CHANNEL_WEBHOOK_KILL_SWITCH: ${REAL_CHANNEL_WEBHOOK_KILL_SWITCH:-true}
      REAL_CHANNEL_WEBHOOK_SECRETS: ${REAL_CHANNEL_WEBHOOK_SECRETS:-[]}
      REAL_CHANNEL_WEBHOOK_ALLOWLIST: ${REAL_CHANNEL_WEBHOOK_ALLOWLIST:-[]}
      REAL_CHANNEL_WEBHOOK_MAX_AGE_SECONDS: ${REAL_CHANNEL_WEBHOOK_MAX_AGE_SECONDS:-300}
      REAL_CHANNEL_WEBHOOK_RATE_LIMIT_PER_MINUTE: ${REAL_CHANNEL_WEBHOOK_RATE_LIMIT_PER_MINUTE:?set REAL_CHANNEL_WEBHOOK_RATE_LIMIT_PER_MINUTE}
      CHANNEL_QUEUE_PENDING_WARN_THRESHOLD: ${CHANNEL_QUEUE_PENDING_WARN_THRESHOLD:?set CHANNEL_QUEUE_PENDING_WARN_THRESHOLD}
      CHANNEL_QUEUE_OLDEST_PENDING_WARN_SECONDS: ${CHANNEL_QUEUE_OLDEST_PENDING_WARN_SECONDS:?set CHANNEL_QUEUE_OLDEST_PENDING_WARN_SECONDS}
      CHANNEL_QUEUE_STALE_PROCESSING_WARN_THRESHOLD: ${CHANNEL_QUEUE_STALE_PROCESSING_WARN_THRESHOLD:?set CHANNEL_QUEUE_STALE_PROCESSING_WARN_THRESHOLD}
      CHANNEL_QUEUE_STALE_AFTER_MINUTES: ${CHANNEL_QUEUE_STALE_AFTER_MINUTES:?set CHANNEL_QUEUE_STALE_AFTER_MINUTES}
      OPERATOR_IDENTITY_PROVIDER: database
      OPERATOR_ACCOUNT_SOURCE: database
      OPERATOR_SESSION_SECRET: ${OPERATOR_SESSION_SECRET:?set OPERATOR_SESSION_SECRET}
      OPERATOR_API_KEYS: ${OPERATOR_API_KEYS:?set OPERATOR_API_KEYS}
      PROVIDER_READONLY_ADAPTERS: ${PROVIDER_READONLY_ADAPTERS:-[]}
      PROVIDER_CREDENTIALS: ${PROVIDER_CREDENTIALS:-[]}
      ENABLE_LEGACY_WEB_DEMO_API: "false"
      NEXT_PUBLIC_ENABLE_OFFLINE_DEMO: "false"
      ALLOW_INSECURE_OPERATOR_HEADERS: "false"
      SMART_CS_LOAD_DOTENV: "false"
    ports:
      - "${SMARTCS_API_PORT:-4100}:4100"

  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
    restart: unless-stopped
    depends_on:
      api:
        condition: service_healthy
    environment:
      NODE_ENV: production
      PORT: 3000
      API_URL: ${API_URL:?set API_URL}
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:?set NEXT_PUBLIC_API_URL}
      NEXT_PUBLIC_WS_URL: ${NEXT_PUBLIC_WS_URL:?set NEXT_PUBLIC_WS_URL}
      NEXT_PUBLIC_ENABLE_OFFLINE_DEMO: "false"
      ENABLE_LEGACY_WEB_DEMO_API: "false"
      OPERATOR_IDENTITY_PROVIDER: database
      OPERATOR_ACCOUNT_SOURCE: database
      OPERATOR_SESSION_SECRET: ${OPERATOR_SESSION_SECRET:?set OPERATOR_SESSION_SECRET}
    ports:
      - "${SMARTCS_WEB_PORT:-3000}:3000"

volumes:
  smart-cs-agent-postgres:
